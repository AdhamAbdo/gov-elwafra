# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server/scripts ONLY (scheduler, notifications, demo provisioning). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the deployed app, used in notification emails.
APP_URL=http://localhost:3000

# Optional email delivery (Resend). Without both values, in-app notifications still work and
# emails are recorded as "skipped_unconfigured".
RESEND_API_KEY=
EMAIL_FROM=
